<Project>
  <!--
    External package versions are pinned centrally so every project restores the
    same reviewed dependency version. New packages require the dependency and
    licensing review documented under docs/en/project.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- R0.2 visual pilot: isolated to Sasd.Ui.WinForms.Krypton. -->
    <PackageVersion Include="Krypton.Toolkit" Version="105.26.7.201" />
  </ItemGroup>
</Project>
