<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Sasd.Ui.PlatformShowcase</RootNamespace>
    <AssemblyName>Sasd.Ui.PlatformShowcase</AssemblyName>
    <Description>Integrated example application demonstrating and manually exercising SASD UI Platform components.</Description>
    <!-- Example code favors clarity over micro-optimizing private collection return types. -->
    <NoWarn>$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sasd.Ui.Core\Sasd.Ui.Core.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms\Sasd.Ui.WinForms.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Commands\Sasd.Ui.WinForms.Commands.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Data\Sasd.Ui.WinForms.Data.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Dialogs\Sasd.Ui.WinForms.Dialogs.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Forms\Sasd.Ui.WinForms.Forms.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Media\Sasd.Ui.WinForms.Media.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Shell\Sasd.Ui.WinForms.Shell.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.State\Sasd.Ui.WinForms.State.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Theming\Sasd.Ui.WinForms.Theming.csproj" />
    <ProjectReference Include="..\..\src\Sasd.Ui.WinForms.Windows\Sasd.Ui.WinForms.Windows.csproj" />
  </ItemGroup>
</Project>
