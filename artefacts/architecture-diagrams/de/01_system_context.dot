digraph G {

  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65"];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#36546B", fillcolor="#EEF4F7", fontcolor="#172B3A", margin="0.14,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#567386", fontcolor="#36546B", arrowsize=0.7];

  rankdir=LR;
  dev [label="SASD-Entwickler\nund Maintainer", shape=ellipse, fillcolor="#E8F0F8"];
  apps [label="SASD-WinForms-Anwendungen\nPrompt Manager | Mail Workbench | Notes | Utilities", fillcolor="#DCEAF2"];
  platform [label="SASD UI Platform\nWinForms-Komponenten, Services, Templates", fillcolor="#D3E4ED", penwidth=2];
  windows [label="Windows 10/11\nWinForms | DPI | UI Automation | High Contrast"];
  feed [label="Interner NuGet-Feed\nPakete, Symbole, XML-Dokumentation"];
  third [label="Drittbibliotheken\nKrypton | ScottPlot | ScintillaNET | WebView2 | weitere Adapter"];
  ci [label="GitHub/CI-Runner\nBuild | Tests | SBOM | Paketierung"];
  users [label="Anwendungsnutzer", shape=ellipse, fillcolor="#E8F0F8"];
  dev -> platform [label="entwickelt und pflegt"];
  platform -> feed [label="veröffentlicht"];
  apps -> feed [label="bezieht Pakete", dir=back];
  apps -> platform [label="nutzt"];
  platform -> windows [label="läuft auf"];
  platform -> third [label="adaptiert"];
  ci -> platform [label="prüft"];
  users -> apps [label="bedient"];
}