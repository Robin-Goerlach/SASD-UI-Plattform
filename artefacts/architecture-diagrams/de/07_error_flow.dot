digraph G {

  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65"];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#36546B", fillcolor="#EEF4F7", fontcolor="#172B3A", margin="0.14,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#567386", fontcolor="#36546B", arrowsize=0.7];

  rankdir=LR;
  source [label="Control / Service / Command"];
  expected [label="Erwartbarer Fehler\nUiOperationResult", fillcolor="#EAF3E6"];
  exception [label="Unerwartete Exception", fillcolor="#F7E7E5"];
  boundary [label="UI Error Boundary\nKorrelation + Logging", fillcolor="#D3E4ED", penwidth=2];
  presenter [label="SasdErrorPresenter"];
  user [label="Benutzertext\nknapp, handlungsorientiert"];
  details [label="Technische Details\nkopierbar, optional"];
  log [label="ILogger\nkeine Secrets/Nutzinhalte"];
  source -> expected;
  source -> exception;
  expected -> presenter;
  exception -> boundary -> presenter;
  boundary -> log;
  presenter -> user;
  presenter -> details;
}