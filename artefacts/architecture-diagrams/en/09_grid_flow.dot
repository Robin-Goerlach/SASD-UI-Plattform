digraph G {

  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65"];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#36546B", fillcolor="#EEF4F7", fontcolor="#172B3A", margin="0.14,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#567386", fontcolor="#36546B", arrowsize=0.7];

  rankdir=LR;
  vm [label="Application data / query service"];
  controller [label="SasdGridController<T>\nColumns | mapping | selection | commands", fillcolor="#D3E4ED", penwidth=2];
  query [label="Search/Filter/Sort/Page Request"];
  data [label="PagedResult<T> / BindingList"];
  grid [label="SasdDataGrid\nDesigner-friendly control"];
  state [label="Grid State\nColumns | sorting | filters"];
  export [label="CSV Export"];
  vm -> controller;
  controller -> query -> vm [label="query"];
  vm -> data -> controller -> grid;
  grid -> controller [label="user events"];
  controller -> state;
  controller -> export;
}