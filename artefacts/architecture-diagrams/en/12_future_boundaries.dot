  web [label="Later: ASP.NET Core/Blazor\nseparate web project", style="rounded,dashed,filled"];
  aspx [label="Later: ASP.NET Web Forms/ASPX\nlegacy/migration project", style="rounded,dashed,filled"];
  java [label="Later: Java/OpenXava\nseparate project", style="rounded,dashed,filled"];
  design -> winforms;
