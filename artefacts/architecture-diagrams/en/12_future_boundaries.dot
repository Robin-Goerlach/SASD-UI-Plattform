  rankdir=LR;
  design [label="Platform-neutral knowledge core\nDesign tokens | semantics | UX rules | component contracts", fillcolor="#D3E4ED", penwidth=2];
  winforms [label="Current: WinForms\nR0–R3", fillcolor="#DCEAF2"];
  wpf [label="Later: WPF\nown rendering/controls", style="rounded,dashed,filled"];
  winui [label="Later: WinUI 3\npilot", style="rounded,dashed,filled"];
