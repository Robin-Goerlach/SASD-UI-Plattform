digraph G {

  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65"];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#36546B", fillcolor="#EEF4F7", fontcolor="#172B3A", margin="0.14,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#567386", fontcolor="#36546B", arrowsize=0.7];

  rankdir=LR;
  source [label="Theme source\nSystem | user | application"];
  service [label="IThemeService", fillcolor="#D3E4ED", penwidth=2];
  tokens [label="SasdThemeDefinition\nColours | typography | spacing | sizes | states"];
  mapping [label="Implementation\nKrypton mapping or native mapping"];
  icons [label="IIconService\nTheme/DPI/state cache"];
  controls [label="SASD controls and composite views"];
  a11y [label="High Contrast / focus / contrast review"];
  source -> service -> tokens -> mapping -> controls;
  tokens -> icons -> controls;
  service -> a11y -> mapping;
}