digraph G {

  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65"];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#36546B", fillcolor="#EEF4F7", fontcolor="#172B3A", margin="0.14,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#567386", fontcolor="#36546B", arrowsize=0.7];

  rankdir=LR;
  input [label="User action\nButton | menu | shortcut"];
  binding [label="CommandBinding\nCommandId + Context"];
  mgr [label="SasdCommandManager\nCanExecute / ExecuteAsync", fillcolor="#D3E4ED", penwidth=2];
  handler [label="Application handler\nbusiness operation"];
  progress [label="Busy/Progress/Status"];
  result [label="UiOperationResult"];
  error [label="ErrorPresenter / Notification"];
  refresh [label="Command State Refresh"];
  input -> binding -> mgr;
  mgr -> handler [label="when executable"];
  handler -> progress [label="reports"];
  handler -> result;
  result -> error [label="error/info"];
  result -> refresh [label="state changed"];
  refresh -> mgr [label="Requery"];
}